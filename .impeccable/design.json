  "narrative": {
    "northStar": "The Studio Job Jacket",
    "overview": "The Studio Job Jacket gives the public homepage the character of a working client file: a deep teal sleeve, pale mint sheets, white records, and restrained citron actions. Literata lends the headings an editorial warmth while plain sans text keeps the records direct and readable.\n\nThis system describes the public homepage only. Authenticated screens retain their existing design; the illustrated client records here are synthetic examples, not redesigned application components.",
    "keyCharacteristics": [
      "Broad editorial headings and plain operational text.",
      "Continuous record surfaces divided by crisp rules.",
      "Color separates the sleeve, sheets, and actions."
    ],
    "rules": [
      {
        "name": "The Sleeve and Sheet Rule",
        "body": "Use tonal ground changes and rules to distinguish records; keep the record plane flat.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the teal sleeve, pale sheets, and readable white records.",
      "Do keep synthetic examples and non-interactive illustrations explicitly labeled.",
      "Do keep the jacket readable during its entry movement and honor reduced motion."
    ],
    "donts": [
      "Don't apply this homepage record automatically to authenticated screens.",
      "Don't give static illustrated fields the appearance or behavior of working inputs.",
      "Don't introduce decorative shadows on the flat record surfaces."
    ]
  }
